# Production environment template. No automatic .env loading by Python.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
ALLOWED_HOSTS=operations.example.com
DATABASE_URL=postgresql://user:password@host:5432/operations?sslmode=require
CSRF_TRUSTED_ORIGINS=https://operations.example.com
ORGANISATION_NAME=Fictional Demo Organisation
ORGANISATION_SECTOR=office
TRUST_PROXY_HTTPS=false
